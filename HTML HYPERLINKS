<!DOCTYPE html>
<html>
<head>
<title>HTML Hyperlinks</title>
<style>
body{font-family:Arial;background-color:#f2f2f2;padding:10px}
h1{text-align:center;color:#1a237e;margin:2px}
.roll{text-align:center;color:#d84315;font-weight:bold;margin:2px}
.box{background:white;padding:8px;margin:5px auto;width:70%;border-radius:5px;box-shadow:0 0 3px gray}
